# The registry: the same address on every chain.
REGISTRY_ADDRESS=0xF412388bF908E510066d3Be5c704bd9A327f945d
# Optional: sponsors imports on the home chain. Without it the service is read-only.
PRIVATE_KEY=
HOME_CHAIN_ID=100
# Optional alerts (stuck queue, low sponsor balance, failed tasks).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# MIN_SPONSOR_BALANCE_WEI=10000000000000000
# MAX_FEE_WEI=10000000
# CHAINS=[{"chainId":100,"name":"Gnosis","rpcs":["https://rpc.gnosischain.com"],"txService":"https://api.safe.global/tx-service/gno","registry":true}]
# RUST_LOG=info
# Behind a reverse proxy that overwrites it: the header holding the client's
# address, for per-client rate limits (cf-connecting-ip, x-forwarded-for).
# Unset: the connection's address. Never set it without such a proxy.
# TRUSTED_IP_HEADER=cf-connecting-ip
